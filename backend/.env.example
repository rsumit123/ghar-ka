# Copy to backend/.env. Every value below is the dev default; the app runs without a .env file.

# dev | prod  (prod makes the session cookie Secure unless COOKIE_SECURE is set)
ENV=dev
# Brand name used in SMS text and API title
BRAND_NAME=gharka
# SQLite for dev; Postgres is a URL change only, e.g. postgresql+psycopg://user:pass@localhost/gharka
DATABASE_URL=sqlite:///./gharka.db
# Allowed browser origins (comma-separated or JSON list); credentials are allowed for these only
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- session cookie ---
COOKIE_NAME=gharka_session
# Leave unset locally; ".skdev.one" in prod so customer + vendor + API subdomains share the cookie
# COOKIE_DOMAIN=.skdev.one
# Leave unset: Secure is on automatically when ENV=prod. Set true/false to force.
# COOKIE_SECURE=true
SESSION_DAYS=30

# --- login ---
# otp: phone + SMS code, open signup. password: invite only (admin adds customers/cooks with a password in /admin/users)
# shared_password: testing only, any mobile number logs in with SHARED_LOGIN_PASSWORD (account created on first login)
AUTH_MODE=otp
SHARED_LOGIN_PASSWORD=

# --- SMS / OTP ---
# "console" logs the OTP to the backend terminal. Add real providers in app/services/sms.py
SMS_PROVIDER=console
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Max OTP requests per phone within the window
OTP_RATE_LIMIT_COUNT=3
OTP_RATE_LIMIT_WINDOW_MINUTES=10
# Used for bare 10-digit numbers
DEFAULT_COUNTRY_CODE=+91

# --- uploads ---
# public/ is served at /media, private/ only through the admin endpoint
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# --- time / slots ---
APP_TIMEZONE=Asia/Kolkata
# Slot start times (HH:MM, local time); tiffin cutoffs are measured back from these
LUNCH_START=12:00
DINNER_START=19:30

# --- discovery ---
# Public vendor listing: same pincode/locality, or within max(vendor's delivery radius, this) km of the customer
PUBLIC_SEARCH_RADIUS_KM=5

# --- payments (COD is always available; also set VITE_RAZORPAY_ENABLED=true in both frontends) ---
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set in the Razorpay dashboard (Webhooks -> payment.captured, payment.failed) -> POST /api/v1/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_URL=https://api.razorpay.com/v1
# Online orders unpaid after this many minutes are cancelled and their portions released
RAZORPAY_PAYMENT_TIMEOUT_MINUTES=15

# --- geocoding (OpenStreetMap Nominatim; respect its usage policy, set a real contact in the UA) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=gharka-dev/0.1 (contact: you@example.com)
GEO_COUNTRY=in
