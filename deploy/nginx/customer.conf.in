# ${BRAND_NAME} customer site (static build with SPA fallback). certbot --nginx adds the 443 block + redirect.
server {
    listen 80;
    listen [::]:80;
    server_name ${CUSTOMER_DOMAIN};

    root ${WWW_DIR}/customer;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Vite output: hashed file names, safe to cache for a year.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff;
    }

    # Everything else falls back to the SPA shell; never cache the shell so deploys show up immediately.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff;
        add_header Referrer-Policy strict-origin-when-cross-origin;
        add_header X-Frame-Options SAMEORIGIN;
    }
}
