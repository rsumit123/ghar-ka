# Copy to .env (optional; these are the dev defaults)
VITE_API_URL=http://localhost:8000
VITE_BRAND_NAME=gharka
# OpenStreetMap raster tiles. For production traffic use a tile provider you're allowed to use.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Fallback map centre "lat,lng" (launch city)
VITE_MAP_CENTER=12.9716,77.5946
# IANA timezone for displaying dates and times (mirror of backend APP_TIMEZONE)
VITE_TIMEZONE=Asia/Kolkata
VITE_RAZORPAY_ENABLED=false
VITE_CUSTOMER_URL=http://localhost:5173
VITE_VENDOR_URL=http://localhost:5174
